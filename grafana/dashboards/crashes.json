                "body": "{\"project\":${project:json},\"environment\":${environment:json},\"issue\":\"${__data.fields.issue_id}\"}",
                "headers": [
                  [
                    "Content-Type",
                    "application/json"
                  ]
                ],
                "queryParams": []
              }
            },
            {
              "title": "Ignore",
              "type": "fetch",
              "fetch": {
                "method": "POST",
                "url": "/api/datasources/proxy/uid/peculiar-insights-manage/peculiar.insights.v1.Manage/IgnoreIssue",
                "body": "{\"project\":${project:json},\"environment\":${environment:json},\"issue\":\"${__data.fields.issue_id}\"}",
                "headers": [
                  [
                    "Content-Type",
                    "application/json"
                  ]
                ],
                "queryParams": []
              }
            },
            {
              "title": "Reopen",
              "type": "fetch",
              "fetch": {
                "method": "POST",
                "url": "/api/datasources/proxy/uid/peculiar-insights-manage/peculiar.insights.v1.Manage/ReopenIssue",
                "body": "{\"project\":${project:json},\"environment\":${environment:json},\"issue\":\"${__data.fields.issue_id}\"}",
                "headers": [
                  [
                    "Content-Type",
                    "application/json"
                  ]
                ],
                "queryParams": []
              }
            }
          ]
