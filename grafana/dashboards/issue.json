          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT * FROM reporting.crash WHERE project = '${project}' AND environment = '${environment}' AND issue_id = ${issue}::bigint ORDER BY time DESC LIMIT 1) SELECT frame.n, (frame.f ->> 'in_app')::boolean AS in_app, frame.f ->> 'module_name' AS module, frame.f ->> 'function' AS function, frame.f ->> 'file' AS file, (frame.f ->> 'line')::integer AS line, (frame.f ->> 'column')::integer AS col FROM latest, jsonb_array_elements(latest.frames) WITH ORDINALITY AS frame(f, n) ORDER BY frame.n",
          "refId": "A"
        }
      ],
