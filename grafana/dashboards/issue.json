          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(time, $__interval), count(*) FILTER (WHERE fatal) AS fatal, count(*) FILTER (WHERE NOT fatal) AS non_fatal FROM reporting.crash WHERE project = '${project}' AND environment = '${environment}' AND issue_id = ${issue}::bigint AND $__timeFilter(time) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Crashes over time",
      "type": "timeseries"
