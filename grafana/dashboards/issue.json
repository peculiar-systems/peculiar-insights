      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "peculiar-insights"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT issue_id, title, exception_type, state, crashes, affected_users, first_seen, last_seen, first_build, last_build, resolved_at, resolved_build, regressed_at FROM reporting.issue WHERE project = '${project}' AND environment = '${environment}' AND issue_id = ${issue}::bigint",
          "refId": "A"
        }
      ],
      "title": "Issue",
      "type": "table"
    },
