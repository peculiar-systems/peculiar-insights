        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "actions": [
            {
              "title": "Resolve",
              "type": "fetch",
              "fetch": {
                "method": "POST",
                "url": "/api/datasources/proxy/uid/peculiar-insights-manage/peculiar.insights.v1.Manage/ResolveIssue",
                "body": "{\"project\":${project:json},\"environment\":${environment:json},\"issue\":\"${issue}\"}",
                "headers": [
                  [
                    "Content-Type",
                    "application/json"
                  ]
                ],
                "queryParams": []
              }
            },
            {
              "title": "Ignore",
              "type": "fetch",
              "fetch": {
                "method": "POST",
                "url": "/api/datasources/proxy/uid/peculiar-insights-manage/peculiar.insights.v1.Manage/IgnoreIssue",
                "body": "{\"project\":${project:json},\"environment\":${environment:json},\"issue\":\"${issue}\"}",
                "headers": [
                  [
                    "Content-Type",
                    "application/json"
                  ]
                ],
                "queryParams": []
              }
            },
            {
              "title": "Reopen",
              "type": "fetch",
              "fetch": {
                "method": "POST",
                "url": "/api/datasources/proxy/uid/peculiar-insights-manage/peculiar.insights.v1.Manage/ReopenIssue",
                "body": "{\"project\":${project:json},\"environment\":${environment:json},\"issue\":\"${issue}\"}",
                "headers": [
                  [
                    "Content-Type",
                    "application/json"
                  ]
                ],
                "queryParams": []
              }
            }
          ]
