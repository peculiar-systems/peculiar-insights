      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "peculiar-insights"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT step || '. ' || name AS step, people FROM (WITH f AS (SELECT step, name, people FROM reporting.funnel('${project}', '${environment}', ARRAY(SELECT trim(s) FROM unnest(string_to_array('${steps}', ',')) AS s WHERE trim(s) <> ''), interval '${window}', $__timeFrom(), $__timeTo())) SELECT step, name, people, round(100.0 * people / NULLIF(first_value(people) OVER (ORDER BY step), 0), 1) AS overall_pct, round(100.0 * people / NULLIF(lag(people) OVER (ORDER BY step), 0), 1) AS step_pct, lag(people) OVER (ORDER BY step) - people AS dropped FROM f ORDER BY step) AS f ORDER BY step",
          "refId": "A"
        }
      ],
      "title": "People reaching each step",
      "type": "barchart"
    },
