          "rawQuery": true,
          "rawSql": "SELECT round(100.0 * last_value(people) OVER () / NULLIF(first_value(people) OVER (), 0), 1) AS conversion FROM (SELECT step, name, people FROM reporting.funnel('${project}', '${environment}', ARRAY(SELECT trim(s) FROM unnest(string_to_array('${steps}', ',')) AS s WHERE trim(s) <> ''), interval '${window}', $__timeFrom(), $__timeTo())) AS f ORDER BY step DESC LIMIT 1",
