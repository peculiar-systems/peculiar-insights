        {
          "datasource": {
            "type": "postgres",
            "uid": "peculiar-insights"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(cohort, 'YYYY-MM-DD') AS cohort, period, retained_pct FROM (SELECT cohort, period, cohort_size, retained, round(100.0 * retained / NULLIF(cohort_size, 0), 1) AS retained_pct FROM reporting.retention('${project}', '${environment}', '${birth}', '${return}', '${period}', $__timeFrom(), $__timeTo(), ${periods}::integer)) AS r ORDER BY cohort, period",
          "refId": "A"
        }
      ],
      "title": "Retention by cohort (${period}s since birth, percent of cohort)",
