          "rawSql": "SELECT period, round(100.0 * sum(retained) / NULLIF(sum(cohort_size), 0), 1) AS retained_pct FROM (SELECT cohort, period, cohort_size, retained, round(100.0 * retained / NULLIF(cohort_size, 0), 1) AS retained_pct FROM reporting.retention('${project}', '${environment}', '${birth}', '${return}', '${period}', $__timeFrom(), $__timeTo(), ${periods}::integer)) AS r GROUP BY period ORDER BY period",
